# Environment variables declared in this file are available at build time and runtime.
# More info: https://nextjs.org/docs/basic-features/environment-variables

# Prisma Database URL for MariaDB/MySQL
# Para Docker local (usar esta - puerto 3310):
DATABASE_URL="mysql://root:password@localhost:3310/vl_survey"

# Para instalación local de MariaDB (puerto estándar 3306):
# DATABASE_URL="mysql://root:tu_password@localhost:3306/vl_survey"

# MariaDB specific configurations (optional parameters):
# DATABASE_URL="mysql://username:password@localhost:3306/vl_survey_db?sslaccept=strict&charset=utf8mb4&collation=utf8mb4_unicode_ci"

# For production with SSL and additional MariaDB optimizations:
# DATABASE_URL="mysql://username:password@host:port/database_name?sslaccept=strict&charset=utf8mb4&collation=utf8mb4_unicode_ci&timezone=UTC"

# Next.js Environment
NODE_ENV="development"

# JWT Secret for token validation (generate a secure random string)
JWT_SECRET="your-super-secure-jwt-secret-key-here-change-this-in-production"

# reCAPTCHA v3 Configuration
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6LxxxxxxxxxxxxxxxxxxxXXX"
RECAPTCHA_SECRET_KEY="6LxxxxxxxxxxxxxxxxxxxXXX_XXXXXXXX"

# ERP API Configuration
ERP_API_BASE_URL="https://viladomat-test.cloud.openbravo.com/openbravo"
ERP_API_USER="your-erp-username"
ERP_API_PWD="your-erp-password"

# Next.js API Base URL
NEXT_PUBLIC_API_BASE_URL="/api"

# Application Configuration
MAX_SESSION_TIMEOUT=300000
MAX_COMMENT_LENGTH=250

# Admin API Key for protected endpoints (generate a secure random string)
ADMIN_API_KEY="your-admin-api-key-here-change-this-in-production"

# Admin Panel Credentials
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="viladomat2024"
