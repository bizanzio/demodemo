generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model SizeSystem {
  id           Int        @id @default(autoincrement())
  systemName   String     @db.VarChar(50) @unique
  isDefault    Boolean    @default(false)
  displayOrder Int        @default(0)
  sizes        Size[]
  categories   Category[] @relation("CategoryToSizingSystems")
  originCategories Category[] @relation("CategoryToOriginSystem")
  predefinedCategories Category[] @relation("CategoryToPredefinedSystem")
  sizeValues   SizeValue[]
  translations SizeSystemTranslation[]
}

model SizeSystemTranslation {
  id           Int        @id @default(autoincrement())
  sizeSystemId Int
  locale       String     @db.VarChar(5)  // es, ca, en, it, fr, de
  name         String     @db.VarChar(100)
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)

  @@unique([sizeSystemId, locale])
  @@index([sizeSystemId])
}

model Supplier {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(100) @unique
  categories     Category[]
  sizes          Size[]
}

model Gender {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(50) @unique
  categories Category[]
}

model Category {
  id             Int         @id @default(autoincrement())
  name           String      @db.VarChar(100)
  genderId       Int?
  supplierId     Int?
  originSystemId Int?
  predefinedSystemId Int?
  gender         Gender?     @relation(fields: [genderId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_ibfk_1")
  supplier       Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_ibfk_2")
  sizingSystems  SizeSystem[] @relation("CategoryToSizingSystems")
  sizes          Size[]
  originSystem   SizeSystem? @relation("CategoryToOriginSystem", fields: [originSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  predefinedSystem   SizeSystem? @relation("CategoryToPredefinedSystem", fields: [predefinedSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  intCategories  Int_Category[] @relation("IntCategoryToCategory")
  images         CategoryImage[]
  sizeExceptions ProductSizeException[] @relation("RedirectCategory")

  @@unique([supplierId, genderId, name])
  @@index([genderId], map: "genderId")
  @@index([supplierId], map: "supplierId")
  @@index([originSystemId], map: "originSystemId")
}

model CategoryImage {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  filename    String   @db.VarChar(255)
  originalName String  @db.VarChar(255)
  mimeType    String   @db.VarChar(100)
  size        Int
  url         String   @db.VarChar(500)
  order       Int      @default(0)
  alt         String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId], map: "categoryId")
}


model Int_Category {
  id Int @id @default(autoincrement())
  referenceId String @db.VarChar(50) @unique
  name String @db.VarChar(100)
  categories Category[] @relation("IntCategoryToCategory")
}

model ProductSizeException {
  id                    Int          @id @default(autoincrement())
  modelCodes            String       @db.Text
  redirectCategoryId    Int
  notes                 String?      @db.Text
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  redirectCategory      Category     @relation("RedirectCategory", fields: [redirectCategoryId], references: [id], onDelete: Cascade)

  @@index([redirectCategoryId])
}

model Size {
  id              Int         @id @default(autoincrement())
  originalSize    String      @db.VarChar(10)
  displayOrder    Int?
  supplierId      Int?
  categoryId      Int?
  sizeSystemId    Int?
  supplier        Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "size_ibfk_1")
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "size_ibfk_2")
  sizeSystem      SizeSystem? @relation(fields: [sizeSystemId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "size_ibfk_3")
  sizeValues      SizeValue[]

  @@index([categoryId], map: "categoryId")
  @@index([sizeSystemId], map: "sizeSystemId")
  @@index([supplierId], map: "supplierId")
}

model SizeValue {
  id           Int        @id @default(autoincrement())
  value        String     @db.VarChar(20)
  sizeId       Int
  sizeSystemId Int
  size         Size       @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  sizeSystem   SizeSystem @relation(fields: [sizeSystemId], references: [id], onDelete: Cascade)

  @@unique([sizeId, sizeSystemId])
  @@index([sizeId], map: "sizeId")
  @@index([sizeSystemId], map: "sizeSystemId")
}

model SizeGuideChart {
  id          Int      @id @default(autoincrement())
  referenceId String   @db.VarChar(50)
  supplierId  Int      @default(0)
  genderId    Int      @default(0)
  locale      String   @default("") @db.VarChar(5)
  url         String   @db.VarChar(500)
  minioKey    String   @db.VarChar(500)
  dataHash    String   @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([referenceId, supplierId, genderId, locale])
  @@index([referenceId])
}

model users {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(100)
  email String @unique(map: "email") @db.VarChar(100)
}
